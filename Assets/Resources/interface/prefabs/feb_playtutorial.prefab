  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1818296695555359}
  m_Text: "Gaia성 전투에 승리하였습니다.\r\nGaia성은 이제 군주님의 성이 되었습니다.\r\n\r\n마을에는 장비 및 스킬을 구매할 수 있습니다.\r\n각 캐슬별로 군사 및 건설을 진행 하기 위해서는 Map으로 이동하여야 합니다.\r\nMap 버튼을 터치해 보세요."
  m_OffsetZ: 0
  m_CharacterSize: 16
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
